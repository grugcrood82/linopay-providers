{
  "name": "@linotech/cli",
  "version": "0.1.0",
  "description": "Official LinoPay CLI. The 5-minute terminal integration: `linopay init` + `linopay verify`. Wraps @linotech/sdk with no extra moving parts.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "linopay": "./dist/index.js"
  },
  "files": [
    "dist",
    "install",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@linotech/sdk": "file:../node",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
